  {
    "id": "zed",
    "name": "Zed",
    "kind": "file",
    "restart": "Check Settings > AI > MCP Servers. A green dot means APM is running.",
    "notes": "Zed's settings file usually has comments. If it does, pm shows the entry to add instead of changing the file.",
    "configFiles": {
      "darwin": "~/.config/zed/settings.json",
      "linux": "$XDG_CONFIG_HOME/zed/settings.json",
      "win32": "%APPDATA%\\Zed\\settings.json"
    },
    "configFormat": "jsonc",
    "configKey": "context_servers",
    "entry": {
      "command": "pm",
      "args": [
        "mcp",
        "serve",
        "--client",
        "zed"
      ],
      "env": {}
    },
    "clientInfoName": "Zed"
  },
  {
    "id": "opencode",
    "name": "OpenCode",
    "kind": "file",
    "restart": "Restart OpenCode. opencode mcp list shows APM and whether it's connected.",
    "configFiles": {
      "darwin": "~/.config/opencode/opencode.json",
      "linux": "~/.config/opencode/opencode.json",
      "win32": "%USERPROFILE%\\.config\\opencode\\opencode.json"
    },
    "configFormat": "json",
    "configKey": "mcp",
    "entry": {
      "type": "local",
      "command": [
        "pm",
        "mcp",
        "serve",
        "--client",
        "opencode"
      ],
      "enabled": true
    },
    "clientInfoName": "opencode"
  },
