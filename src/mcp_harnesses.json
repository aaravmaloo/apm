      "apm",
      "--",
      "pm",
      "mcp",
      "serve",
      "--client",
      "windsurf"
    ],
    "restart": "Restart Devin Desktop or start a new Devin session, then check the MCP list in the agent panel.",
    "notes": "Formerly Windsurf. Needs the devin command.",
    "clientInfoName": "windsurf-client"
  },
