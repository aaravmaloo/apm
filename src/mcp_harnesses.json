[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "kind": "cli",
    "argv": [
      "claude",
      "mcp",
      "add",
      "--scope",
      "user",
      "apm",
      "--",
      "pm",
      "mcp",
      "serve",
      "--client",
      "claude-code"
    ],
    "restart": "Start a new Claude Code session, or run /mcp in Claude Code to check that APM is connected.",
    "notes": "Needs the claude command. Adds APM for all your projects.",
    "clientInfoName": "claude-code"
  },
  {
    "id": "cursor",
    "name": "Cursor",
    "kind": "deeplink",
    "url": "cursor://anysphere.cursor-deeplink/mcp/install?name=apm&config=eyJjb21tYW5kIjoicG0iLCJhcmdzIjpbIm1jcCIsInNlcnZlIiwiLS1jbGllbnQiLCJjdXJzb3IiXX0=",
    "restart": "Cursor asks you to install APM when the link opens. You can check it in Cursor Settings, under MCP.",
    "clientInfoName": "cursor-vscode"
  },
  {
    "id": "vscode",
    "name": "VS Code",
    "kind": "cli",
    "argv": [
      "code",
      "--add-mcp",
      "{\"name\":\"apm\",\"command\":\"pm\",\"args\":[\"mcp\",\"serve\",\"--client\",\"vscode\"]}"
    ],
    "url": "vscode:mcp/install?%7B%22name%22%3A%22apm%22%2C%22command%22%3A%22pm%22%2C%22args%22%3A%5B%22mcp%22%2C%22serve%22%2C%22--client%22%2C%22vscode%22%5D%7D",
    "restart": "VS Code asks you to trust APM the first time it starts. Run MCP: List Servers and start APM, or open Chat in Agent mode.",
    "notes": "Needs the code command. On a Mac, run Shell Command: Install 'code' command in PATH in VS Code first.",
    "clientInfoName": "Visual Studio Code"
  },
  {
    "id": "codex",
    "name": "Codex",
    "kind": "cli",
    "argv": [
      "codex",
      "mcp",
      "add",
