      "add",
      "apm",
      "--",
      "pm",
      "mcp",
      "serve",
      "--client",
      "codex"
    ],
    "restart": "In the ChatGPT desktop app, open Settings > MCP servers and restart. Type /mcp in the composer to check it.",
    "notes": "The ChatGPT desktop app uses Codex's MCP settings, so this runs Codex's setup. Needs the codex command.",
    "clientInfoName": "codex-mcp-client"
