  {
    "id": "claude-desktop",
    "name": "Claude Desktop",
    "kind": "file",
    "restart": "Quit Claude Desktop fully and open it again. APM then shows under + > Connectors.",
    "notes": "Claude Desktop doesn't see your shell's PATH, so pm writes its full path.",
    "configFiles": {
      "darwin": "~/Library/Application Support/Claude/claude_desktop_config.json",
      "win32": "%APPDATA%\\Claude\\claude_desktop_config.json"
    },
    "configFormat": "json",
    "configKey": "mcpServers",
    "entry": {
      "command": "pm",
      "args": [
        "mcp",
        "serve",
        "--client",
        "claude-desktop"
      ]
    },
    "clientInfoName": "claude-ai"
  },
  {
    "id": "windsurf",
    "name": "Windsurf (Devin Desktop)",
    "kind": "cli",
    "argv": [
