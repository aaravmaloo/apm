{
  "manifest_version": 3,
  "name": "APM Passkeys",
  "version": "0.1.0",
  "description": "Save and use WebAuthn passkeys with the APM vault. When a site creates a passkey, a popup asks which vault entry to save it to.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "APM Passkeys",
    "default_popup": "src/popup/index.html",
    "default_icon": { "32": "icons/icon-32.png", "128": "icons/icon-128.png" }
  },
  "icons": { "32": "icons/icon-32.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content_main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
